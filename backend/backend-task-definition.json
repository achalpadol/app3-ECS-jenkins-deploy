{
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "552940445807.dkr.ecr.ap-south-1.amazonaws.com/app-3-backend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "main-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MYSQL_DATABASE",
          "value": "example"
        },
        {
          "name": "MYSQL_HOST",
          "value": "app3-db.ecs.employee.local"
        },
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "Achal123"
        },
        {
          "name": "MYSQL_USER",
          "value": "root"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app3-backend-task-definition",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "app3-backend-task-definition",
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072"
}